{
  "appId": "io.github.rianvegeta1991.oregano",
  "appName": "Oregano",
  "webDir": "www",
  "backgroundColor": "#f4f6f4",
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_oregano",
